import numpy as np

# ===== بيانات المعايرة =====
x = np.array([0.0000, 0.0104, 0.0400, 0.0798, 0.1565])   # Absorbance
y = np.array([0, 5, 18.1, 41.4, 97.3]) # Concentration

def natural_cubic_spline(x, y):
    n = len(x) - 1
    h = np.diff(x)
    alpha = np.zeros(n)
    for i in range(1, n):
        alpha[i] = (3/h[i])*(y[i+1]-y[i]) - (3/h[i-1])*(y[i]-y[i-1])
    
    l = np.ones(n+1)
    mu = np.zeros(n+1)
    z = np.zeros(n+1)
    
    for i in range(1, n):
        l[i] = 2*(x[i+1]-x[i-1]) - h[i-1]*mu[i-1]
        mu[i] = h[i]/l[i]
        z[i] = (alpha[i] - h[i-1]*z[i-1])/l[i]
    
    # المعاملات
    a = y
    b = np.zeros(n)
    c = np.zeros(n+1)
    d = np.zeros(n)
    
    for j in range(n-1, -1, -1):
        c[j] = z[j] - mu[j]*c[j+1]
        b[j] = (y[j+1]-y[j])/h[j] - h[j]*(c[j+1] + 2*c[j])/3
        d[j] = (c[j+1] - c[j])/(3*h[j])
        
    return a[:-1], b, c[:-1], d, x

a, b, c, d, knots = natural_cubic_spline(x, y)

def get_concentration(abs_val):
    # البحث عن القطعة المناسبة
    idx = np.searchsorted(knots, abs_val) - 1
    idx = max(0, min(idx, len(knots)-2))
    
    dx = abs_val - knots[idx]
    return a[idx] + b[idx]*dx + c[idx]*dx**2 + d[idx]*dx**3

print(f"التركيز عند Abs 0.1 هو: {get_concentration(0.1):.4f}")
